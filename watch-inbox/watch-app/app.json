{
  "configVersion": "v3",
  "app": {
    "appId": 1093715,
    "appName": "Watch Inbox",
    "appType": "app",
    "version": {
      "code": 1,
      "name": "1.0.0"
    },
    "icon": "icon.png",
    "vender": "personal",
    "description": "Tap a button to log a note to a Google Doc"
  },
  "permissions": ["data:os.device.info", "device:os.local_storage"],
  "runtime": {
    "apiVersion": {
      "compatible": "3.6",
      "target": "3.6",
      "minVersion": "3.6"
    }
  },
  "targets": {
    "balance": {
      "module": {
        "page": {
          "pages": ["page/index"]
        },
        "app-widget": {
          "widgets": [
            {
              "path": "app-widget/index",
              "icon": "icon.png",
              "name": "Watch Inbox",
              "runtime": {
                "type": "js"
              }
            }
          ]
        },
        "app-side": {
          "path": "app-side/index"
        },
        "setting": {
          "path": "setting/index"
        }
      },
      "platforms": [
        {
          "st": "r",
          "dw": 480
        }
      ]
    }
  },
  "i18n": {
    "en-US": {
      "appName": "Watch Inbox",
      "app-widget": {
        "widgets": [
          {
            "name": "Watch Inbox"
          }
        ]
      }
    }
  },
  "defaultLanguage": "en-US",
  "debug": false
}
